# Local: call Nest directly.
NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# Production (Vercel): use same-origin `/v1` + rewrite proxy so refresh cookies are first-party.
# NEXT_PUBLIC_API_URL=/v1
# API_PROXY_TARGET=https://ruma-app-production.up.railway.app

# Optional client error tracking (public DSN only — never put auth secrets here)
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# Product version in the UI — normally injected from apps/web/package.json (do not set locally)
# NEXT_PUBLIC_APP_VERSION=1.1.0
