NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ruma?schema=public
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
INVITATION_TTL_SECONDS=604800
PASSWORD_RESET_TTL_SECONDS=3600
EMAIL_FROM=RUMA <onboarding@resend.dev>
# RESEND_API_KEY=
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# Optional Gmail OAuth (Phase 2D email import)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URL=http://localhost:3000/integrations/gmail/callback
# 32-byte hex key for encrypting OAuth tokens at rest
# EMAIL_TOKEN_ENCRYPTION_KEY=
# Finance capture (server only; leave unset to disable)
# HERMES_SERVICE_TOKEN=generate-at-least-32-random-characters
# TELEGRAM_BOT_TOKEN=configure-in-server-secret-management
# TELEGRAM_BOT_USERNAME=your_ruma_bot
# TELEGRAM_WEBHOOK_SECRET=generate-at-least-32-random-url-safe-characters
# Optional custom Hermes intent adapter; model/9Router credentials stay in Hermes
# HERMES_INTENT_URL=https://your-hermes-adapter.example/interpret
# HERMES_INTENT_TOKEN=generate-at-least-32-random-characters
# Private persistent directory; never expose through a static web server
# FINANCE_RECEIPT_DIR=C:\ruma-private\receipts
# OCR_PROVIDER_URL=https://your-vision-adapter.example/extract
# OCR_PROVIDER_TOKEN=configure-in-server-secret-management
# Enable only after Telegram linking and schedule recipients have been verified
FINANCE_JOBS_ENABLED=false
